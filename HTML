<!DOCTYPE html>
<html lang="es">
<head>
<link rel="stylesheet" href="style.css">
  <meta charset="UTF-8">
  <title>LAS PILCHAS</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: black;
      color: white;
      text-align: center;
    }

    header {
      padding: 20px;
    }

    img.logo {
      width: 120px;
      margin-top: 20px;
    }

    h1 {
      font-size: 40px;
      margin: 10px 0;
      letter-spacing: 2px;
    }

    p {
      color: #aaa;
    }

    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 25px;
      background: white;
      color: black;
      text-decoration: none;
      border-radius: 20px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn:hover {
      background: #ccc;
    }

    .productos {
      margin-top: 80px;
    }

    .card {
      display: inline-block;
      background: #111;
      margin: 15px;
      padding: 20px;
      border-radius: 15px;
      width: 200px;
    }

    .card:hover {
      transform: scale(1.05);
      transition: 0.3s;
    }
  </style>
</head>
<body>

<header>
  <img src="logo.png" class="logo">
  <h1>LAS PILCHAS</h1>
  <p>Estilo urbano • Tu identidad</p>
  <a class="btn" href="#">Ver productos</a>
</header>

<section class="productos">
  <div class="card">
    <h3>Remeras</h3>
    <p>Diseño exclusivo</p>
  </div>

  <div class="card">
    <h3>Buzos</h3>
    <p>Calidad premium</p>
  </div>

  <div class="card">
    <h3>Gorras</h3>
    <p>Street style</p>
  </div>
</section>

</body>
</html>
